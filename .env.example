# Copy to .env and fill in. Never commit .env.

# ERCOT Public API (apiexplorer.ercot.com)
ERCOT_PUBLIC_API=   # subscription key (Profile > Primary key)
ERCOT_EMAIL=        # ERCOT API Explorer login, used to request hourly ID tokens
ERCOT_PW=

# Local S3-compatible storage (SeaweedFS). Local-only credentials; Spark, Trino,
# and the REST catalog all use the same pair. Named S3_* rather than AWS_* so a
# real AWS key exported in your shell can never leak into the local stack.
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
S3_REGION=us-east-1
